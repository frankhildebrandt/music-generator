{
  "name": "music-generator-desktop",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node --test scripts/desktop/targets.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "engine:prepare": "node scripts/desktop/prepare-engine.mjs",
    "bundle": "node scripts/desktop/build.mjs",
    "tauri": "tauri",
    "lint": "eslint frontend",
    "plugin:prepare": "node scripts/plugin/prepare.mjs",
    "plugin:build": "node scripts/plugin/build.mjs",
    "test:plugin": "cmake -S plugin -B plugin/build-test -DLOOPS_DSP_ONLY=ON -DCMAKE_BUILD_TYPE=Release && cmake --build plugin/build-test --config Release && ctest --test-dir plugin/build-test -C Release --output-on-failure",
    "plugin:validate": "node scripts/plugin/validate.mjs",
    "plugin:verify": "node scripts/plugin/verify.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
